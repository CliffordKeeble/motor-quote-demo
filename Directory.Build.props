<Project>

  <!-- net10.0, the current .NET. From 16 to 18 October 2026 this was net9.0, because two deploys
       with apiRuntime dotnet-isolated:10.0 failed at Static Web Apps' Functions step ("Failed to
       deploy the Azure Functions.", about 16 s after the upload). A net9.0 deploy then failed the
       same way, and on 17 October the same pipeline deployed the same net9.0 commit cleanly with
       nothing changed, so those failures were on Azure's side and are no evidence against .NET 10.
       This target and "apiRuntime" in web/react/public/staticwebapp.config.json (this file's
       partner; JSON takes no comment) move together. Board A20. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- The full bar from the first line: the .NET analyzers at their recommended level, and any
         warning is an error. The NuGet audit codes stay warnings on purpose: they depend on what
         the feed knows today, and the pipeline fails on them by its own step instead
         (the "list package" vulnerable check). -->
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
