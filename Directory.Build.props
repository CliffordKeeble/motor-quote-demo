<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- The full bar from the first line: the .NET analyzers at their recommended level, and any
         warning is an error. The NuGet audit codes stay warnings on purpose: they depend on what
         the feed knows today, and the pipeline fails on them by its own step instead
         (the "list package" vulnerable check). -->
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
